rules_version = '2';

// Who can do what:
//   anyone        reads sales and hips (catalog data)
//   administrator everything staff do, plus approving role requests and deleting accounts
//   staff         write sales, hips; make buyers vets or agents by putting them on a panel
//   anyone        signs up as a buyer and may ask to be a vet, bloodstock agent or staff
//   panel member  (the sale's vet1/vet2/bs1/bs2) writes only their own opinion, always as
//                 pending, and may move only their own slot into opinionsPending / out of opinionsIn
//   staff         approve opinions (status approved, slot moves to opinionsIn)
//   buyer         reads an opinion only after buying it, and only once it's approved
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    // The administrator can do everything staff can, plus approve role requests and delete accounts.
    function isStaff() { return signedIn() && profile().role in ['staff', 'admin']; }
    function isAdmin() { return signedIn() && profile().role == 'admin'; }
    function saleDoc(saleId) { return get(/databases/$(database)/documents/sales/$(saleId)).data; }
    function panelUid(saleId, slot) { return saleDoc(saleId).panel.get(slot, {}).get('uid', ''); }
    function validRequest(data) {
      return !('requestedRole' in data) || data.requestedRole in ['vet', 'agent', 'staff'];
    }
    function isAuthor(saleId, slot) { return signedIn() && panelUid(saleId, slot) == request.auth.uid; }
    function isPanelMember(saleId) {
      return isAuthor(saleId, 'vet1') || isAuthor(saleId, 'vet2') || isAuthor(saleId, 'bs1') || isAuthor(saleId, 'bs2');
    }
    // Every slot in `changed` belongs to the signed-in panel member.
    function onlyOwnSlots(saleId, changed) {
      return (!changed.hasAny(['vet1']) || isAuthor(saleId, 'vet1'))
        && (!changed.hasAny(['vet2']) || isAuthor(saleId, 'vet2'))
        && (!changed.hasAny(['bs1']) || isAuthor(saleId, 'bs1'))
        && (!changed.hasAny(['bs2']) || isAuthor(saleId, 'bs2'));
    }
    // A panel member posting: their slot leaves opinionsIn (never joins it) and joins opinionsPending.
    function panelPostUpdate(saleId) {
      let before = resource.data;
      let after = request.resource.data;
      let inBefore = before.get('opinionsIn', []).toSet();
      let inAfter = after.get('opinionsIn', []).toSet();
      let pendingBefore = before.get('opinionsPending', []).toSet();
      let pendingAfter = after.get('opinionsPending', []).toSet();
      return after.diff(before).affectedKeys().hasOnly(['opinionsIn', 'opinionsPending'])
        && inAfter.difference(inBefore).size() == 0
        && onlyOwnSlots(saleId, inBefore.difference(inAfter))
        && onlyOwnSlots(saleId, pendingAfter.difference(pendingBefore).union(pendingBefore.difference(pendingAfter)));
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      // Everyone signs up as a buyer. Asking to be a vet, bloodstock agent or staff adds requestedRole,
      // and the administrator approves (sets role and lastDecision) or declines it.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'buyer'
        && validRequest(request.resource.data)
        && !('lastDecision' in request.resource.data);
      allow update: if isAdmin()
        // A person asks for, changes or cancels their own role request; never their role itself.
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requestedRole', 'requestedAt'])
            && validRequest(request.resource.data))
        // Staff putting a buyer on a sale panel makes them a vet or agent.
        || (isStaff() && request.auth.uid != uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && resource.data.role in ['buyer', 'vet', 'agent']
            && request.resource.data.role in ['buyer', 'vet', 'agent']);
      // Deleting a whole account (sign-in included) goes through the deleteAccount Cloud Function.
      allow delete: if isAdmin();

      // Phones this person gets push notifications on.
      match /devices/{token} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      match /purchases/{purchaseId} {
        allow read: if signedIn() && request.auth.uid == uid;
        // An App Store purchase, saved with Apple's signed transaction for the right product. The
        // verifyPurchase Cloud Function checks it with Apple and deletes it if it's not genuine.
        // While config/app.testPurchases is on, records without a receipt are allowed too (testing only).
        allow create: if signedIn() && request.auth.uid == uid
          && (get(/databases/$(database)/documents/config/app).data.get('testPurchases', false) == true
              || (request.resource.data.signedTransaction is string
                  && request.resource.data.transactionId is string
                  && request.resource.data.productId == (purchaseId.matches('.*_vet[12]$')
                       ? 'com.example.haintel.vetopinion' : 'com.example.haintel.agentopinion')));
      }
    }

    // Stable PPs (the second app): each person's own horses, race lines and condition books.
    match /stables/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /sales/{saleId} {
      allow read: if true;
      allow write: if isStaff();

      match /hips/{hipId} {
        allow read: if true;
        allow create, delete: if isStaff();
        allow update: if isStaff() || (isPanelMember(saleId) && panelPostUpdate(saleId));

        match /opinions/{slot} {
          allow read: if isStaff() || isAuthor(saleId, slot)
            || (signedIn() && resource.data.get('status', 'approved') == 'approved'
                && exists(/databases/$(database)/documents/users/$(request.auth.uid)/purchases/$(saleId + '_' + hipId + '_' + slot)));
          allow write: if isStaff()
            || (isAuthor(saleId, slot) && request.resource.data.get('status', '') == 'pending');
        }
      }
    }
  }
}
